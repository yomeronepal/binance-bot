# Django Settings
DEBUG=True
SECRET_KEY=your-secret-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration
DATABASE_URL=postgres://binancebot:binancebot123@db:5432/binancebot
POSTGRES_DB=binancebot
POSTGRES_USER=binancebot
POSTGRES_PASSWORD=binancebot123

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME=60
JWT_REFRESH_TOKEN_LIFETIME=1440

# Binance Scanner Settings
BINANCE_API_URL=https://api.binance.com
BINANCE_INTERVAL=5m
POLLING_INTERVAL=60
BINANCE_BATCH_SIZE=20
TOP_PAIRS=50
MIN_CONFIDENCE=0.7

# Binance API Keys (central bot account; optional for public endpoints)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Server IP that users must allowlist on their personal Binance API key.
# Surfaced verbatim to users in the connect-Binance wizard.
BINANCE_SERVER_IP=37.60.248.46

# Fernet symmetric key used to encrypt user-supplied Binance credentials at rest.
# Generate ONCE with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat like a database password: store in your secret manager (.env locally,
# GitHub Actions secrets in CI, server .env on the VPS), never commit.
# Rotating this key invalidates all stored user credentials — they must reconnect.
USER_API_KEY_ENC_KEY=

# API Configuration
API_BASE_URL=http://localhost:8000

# Stripe (for future use)
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
