FROM node:20-alpine AS builder

WORKDIR /app

ARG VITE_API_URL
ARG VITE_WS_URL
ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_MESSAGING_SENDER_ID
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_VAPID_KEY

ENV VITE_API_URL=$VITE_API_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY
ENV VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN
ENV VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID
ENV VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET
ENV VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID
ENV VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_VAPID_KEY=$VITE_FIREBASE_VAPID_KEY

COPY package*.json ./
RUN npm ci

COPY . ./
RUN npm run build && \
    node -e " \
    const fs = require('fs'); \
    const sw = fs.readFileSync('dist/firebase-messaging-sw.js', 'utf8'); \
    const config = { \
      apiKey: process.env.VITE_FIREBASE_API_KEY || '', \
      authDomain: process.env.VITE_FIREBASE_AUTH_DOMAIN || '', \
      projectId: process.env.VITE_FIREBASE_PROJECT_ID || '', \
      storageBucket: process.env.VITE_FIREBASE_STORAGE_BUCKET || '', \
      messagingSenderId: process.env.VITE_FIREBASE_MESSAGING_SENDER_ID || '', \
      appId: process.env.VITE_FIREBASE_APP_ID || '', \
    }; \
    console.log('Injecting Firebase config:', JSON.stringify(config)); \
    const updated = sw.replace( \
      /var firebaseConfig = \\{[^}]*\\};/, \
      'var firebaseConfig = ' + JSON.stringify(config) + ';' \
    ); \
    fs.writeFileSync('dist/firebase-messaging-sw.js', updated); \
    console.log('Firebase config injected into SW'); \
    "

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80 5173

CMD ["nginx", "-g", "daemon off;"]
